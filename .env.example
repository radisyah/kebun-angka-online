# Diisi OTOMATIS oleh integrasi Upstash Redis di Vercel (salah satu pasangan nama ini).
# Hanya perlu diisi manual bila ingin menguji Redis sungguhan dari komputermu.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# atau nama lama dari Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- TURN (Metered) agar Room Master bisa melihat video pemain dari jaringan mana pun ---
# Dashboard Metered → TURN Server → Create API Key. Isi di Vercel → Settings → Environment Variables.
METERED_DOMAIN=            # mis. kebunangka.metered.live (atau cukup: kebunangka)
METERED_API_KEY=
# METERED_REGION=          # opsional: asia / global / dll
